# Copy this file to .env and replace the two placeholders.
APIYI_API_KEY=your_apiyi_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here

# A new index with this name is created automatically on first run.
PINECONE_INDEX=my-first-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=__default__

# Keep the model and vector dimension consistent with the Pinecone index.
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1024
CHAT_MODEL=gpt-4.1-nano
